{
  "name": "ripemd160-js",
  "version": "4.0.0",
  "description": "A tiny, zero-dependency RIPEMD-160 implementation for JavaScript and TypeScript.",
  "bugs": "https://github.com/pur3miish/ripemd160-js/issues",
  "homepage": "https://github.com/pur3miish/ripemd160-js#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "eslint": "eslint .",
    "prettier": "prettier -c .",
    "prettier:fix": "prettier --write .",
    "mocha": "mocha",
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "test": "npm run eslint && npm run prettier && npm run build && npm run mocha",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run smoke",
    "smoke": "npm test && node scripts/smoke-test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pur3miish/ripemd160-js.git"
  },
  "keywords": [
    "ripemd160",
    "ripemd-160",
    "hash",
    "cryptography",
    "crypto",
    "javascript",
    "typescript",
    "esm",
    "browser",
    "node",
    "isomorphic",
    "blockchain"
  ],
  "author": "pur3miish",
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-mocha": "^12.0.2",
    "globals": "^17.9.0",
    "mocha": "^11.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
