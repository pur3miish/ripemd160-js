{
  "name": "ripemd160-js",
  "version": "4.0.0",
  "description": "An universal JavaScript ripemd160 message digest function.",
  "bugs": "https://github.com/pur3miish/ripemd160-js/issues",
  "homepage": "https://github.com/pur3miish/ripemd160-js#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],

"scripts": {
  "eslint": "eslint .",
  "prettier": "prettier -c .",
  "prettier:fix": "prettier --write .",
  "mocha": "mocha",
  "clean": "rm -rf dist",
  "build": "tsc -p tsconfig.json",
  "test": "npm run eslint && npm run prettier && npm run build && npm run mocha",
  "prepublishOnly": "npm run clean && npm test"
},
  "engines": {
    "node": ">=22"
  },
"exports": {
  ".": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "default": "./dist/index.js"
  }
},
  "browserslist": [
    "defaults",
    "not IE 11",
    "maintained node versions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pur3miish/ripemd160-js.git"
  },
  "keywords": [
    "ripemd160",
    "web",
    "assembly",
    "wasm",
    "javascript",
    "blockchain",
    "asymmetric",
    "key",
    "utility",
    "constant",
    "time"
  ],
  "author": "pur3miish",
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-mocha": "^12.0.2",
    "globals": "^17.9.0",
    "mocha": "^11.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
